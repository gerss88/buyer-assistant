{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Справочник городов",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "required": [
      "id",
      "name"
    ],
    "additionalProperties": false
  }
}
