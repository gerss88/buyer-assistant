{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Справочник категорий и характеристик",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "attributes": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["integer", "number", "boolean", "string"]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "aliases": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "minimum": {
              "type": "number",
              "minimum": 1
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "name",
      "attributes"
    ],
    "additionalProperties": false
  }
}
